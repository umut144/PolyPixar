#!/usr/bin/env python

env = SConscript("godot-cpp/SConstruct")

env.Append(
    CPPPATH=[
        "src",
        "third_party/CDT/CDT/include",
    ],
    # CDT reports invalid PSLGs with typed exceptions. Godot-cpp disables
    # exceptions by default, so the narrow native adapter opts back in.
    CXXFLAGS=["-fexceptions"],
)

sources = Glob("src/*.cpp")

if env["platform"] == "macos":
    # macOS loads the extension from a framework bundle.
    target = "bin/libpolytools_cdt.{}.{}.framework/libpolytools_cdt.{}.{}".format(
        env["platform"], env["target"], env["platform"], env["target"]
    )
elif env["platform"] in ("linux", "linuxbsd"):
    # Linux is a build-from-source target for headless verification and CI.
    # Unlike the macOS framework, its product is not checked in.
    target = "bin/libpolytools_cdt.{}.{}.{}{}".format(
        env["platform"], env["target"], env["arch"], env["SHLIBSUFFIX"]
    )
else:
    print("PolyTools CDT supports macOS and Linux.")
    Exit(1)

library = env.SharedLibrary(target, source=sources)

env.NoCache(library)
Default(library)
