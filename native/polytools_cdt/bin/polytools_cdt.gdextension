[configuration]

entry_symbol = "polytools_cdt_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug.arm64 = "res://native/polytools_cdt/bin/libpolytools_cdt.macos.template_debug.framework"
macos.release.arm64 = "res://native/polytools_cdt/bin/libpolytools_cdt.macos.template_release.framework"
linux.debug.x86_64 = "res://native/polytools_cdt/bin/libpolytools_cdt.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://native/polytools_cdt/bin/libpolytools_cdt.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://native/polytools_cdt/bin/libpolytools_cdt.linux.template_debug.arm64.so"
linux.release.arm64 = "res://native/polytools_cdt/bin/libpolytools_cdt.linux.template_release.arm64.so"
