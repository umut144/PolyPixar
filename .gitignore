# Godot editor state and generated import cache
.godot/
.mono/
.export/
exports/

# The Runtime publication unit is generated by Export Runtime and read by the
# consumers straight from the working directory through POLYTOOLS_WORLD_DIR, so
# it is not part of the source history. Run Export Runtime once in a fresh
# clone before the first Consumer Sync.
worlds/*/PolyToolsRuntimeExports/
worlds/*/catalog.json
*.import
*.jpg
*.jpeg

# macOS
.DS_Store

# Logs kept by tools/verify.sh
.verify/

# Residue of an interrupted atomic document write
*.staging
*.backup

# Local native-extension toolchain and build products
native/polytools_cdt/.venv/
native/polytools_cdt/.sconsign.dblite
native/polytools_cdt/godot-cpp/bin/
native/polytools_cdt/godot-cpp/gen/
native/polytools_cdt/godot-cpp/obj/
native/polytools_cdt/src/*.os
native/polytools_cdt/src/*.o
# The macOS framework is checked in; the Linux product is built on demand.
native/polytools_cdt/bin/*.so
